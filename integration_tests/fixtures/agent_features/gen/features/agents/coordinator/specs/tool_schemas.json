{
  "tools": [
    {
      "id": "workflow.draft",
      "service": "features",
      "toolset": "features.workflow",
      "title": "Draft",
      "description": "Draft a response",
      "payload": {
        "name": "DraftPayload",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "description": "Topic to process",
              "example": "Molestiae aut omnis eum voluptatibus corporis maiores."
            }
          },
          "required": [
            "topic"
          ]
        }
      },
      "result": {
        "name": "DraftResult",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "approved": {
              "type": "boolean",
              "description": "Whether the operation was approved",
              "example": true
            },
            "ok": {
              "type": "boolean",
              "description": "Whether the operation succeeded",
              "example": true
            }
          },
          "required": [
            "ok"
          ]
        }
      }
    },
    {
      "id": "workflow.method_echo",
      "service": "features",
      "toolset": "features.workflow",
      "title": "Method Echo",
      "description": "Echo a topic through the generated method dispatcher",
      "payload": {
        "name": "MethodEchoPayload",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "description": "Topic to send to the service method",
              "example": "In ducimus laudantium consequatur libero."
            }
          },
          "required": [
            "topic"
          ]
        }
      },
      "result": {
        "name": "MethodEchoResult",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "description": "Message returned to the agent runtime",
              "example": "Ut voluptatem rem et natus nihil."
            },
            "ok": {
              "type": "boolean",
              "description": "Whether the method-backed tool succeeded",
              "example": true
            }
          },
          "required": [
            "ok",
            "message"
          ]
        }
      }
    },
    {
      "id": "workflow.publish",
      "service": "features",
      "toolset": "features.workflow",
      "title": "Publish",
      "description": "Publish the result",
