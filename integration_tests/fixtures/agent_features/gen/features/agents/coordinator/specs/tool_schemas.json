{
  "tools": [
    {
      "id": "workflow.draft",
      "service": "features",
      "toolset": "features.workflow",
      "title": "Draft",
      "description": "Draft a response",
      "payload": {
        "name": "DraftPayload",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "description": "Topic to process",
              "example": "Quisquam inventore minima consequuntur vero facilis."
            }
          },
          "required": [
            "topic"
          ]
        }
      },
      "result": {
        "name": "DraftResult",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "approved": {
              "type": "boolean",
              "description": "Whether the operation was approved",
              "example": true
            },
            "ok": {
              "type": "boolean",
              "description": "Whether the operation succeeded",
              "example": true
            }
          },
          "required": [
            "ok"
          ]
        }
      }
    },
