+
+type freezeEvidence struct {
+	source      SourceManifest
+	validation  Validation
+	calibration CalibrationArtifact
+	inputs      gate.FreezeInputs
+	pools       []gate.Pool
+}
+
+// BuildVerifiedFreeze authorizes only eligible candidates with complete current
+// source, validation, calibration and declared historical-store evidence.
+func BuildVerifiedFreeze(ctx context.Context, dir, configuration, inventoryPath string) (gate.Freeze, error) {
+	if inventoryPath == "" {
+		return gate.Freeze{}, fmt.Errorf("freeze requires an explicit inventory")
+	}
+	inventory, err := readMigrationInventory(dir, configuration, inventoryPath)
+	if err != nil {
+		return gate.Freeze{}, err
+	}
+	evidence, err := readFreezeEvidence(ctx, dir, configuration)
+	if err != nil {
+		return gate.Freeze{}, err
+	}
+	if evidence.inputs.InventorySHA256 != inventory.SHA256 {
+		return gate.Freeze{}, fmt.Errorf("freeze inventory differs from the retained declaration")
+	}
+	if err := VerifyEvidenceExecutable(ctx, dir); err != nil {
+		return gate.Freeze{}, err
+	}
+	return buildEvidenceFreeze(configuration, evidence)
+}
+
+func readFreezeEvidence(ctx context.Context, dir, configuration string) (freezeEvidence, error) {
+	var out freezeEvidence
+	var err error
+	out.source, err = ReadSource(ctx, dir, configuration)
+	if err != nil {
+		return out, err
+	}
+	out.validation, err = ReadValidationFor(dir, configuration)
+	if err != nil {
+		return out, err
+	}
+	if out.validation.SourceSHA256 != out.source.Identity.SHA256 {
+		return out, fmt.Errorf("validation source identity mismatch")
+	}
+	validationBytes, err := readFile(dir, filepath.Join("gate", filepath.Base(ValidationPath(dir, configuration))))
+	if err != nil {
+		return out, err
+	}
+	calibrationBytes, err := readFile(dir, filepath.Join("gate", filepath.Base(CalibrationPath(dir, configuration))))
+	if err != nil {
+		return out, err
+	}
+	if err := decodeArtifact(calibrationBytes, &out.calibration); err != nil {
+		return out, err
+	}
+	cfg := CalibrationConfig(configuration, out.validation, out.calibration.Config.Workers)
+	if out.calibration.Pilot != nil {
+		cfg.Pilot, err = VerifyPilot(dir, configuration, *out.calibration.Pilot, out.validation.Profile, out.source.Identity.SHA256)
+		if err != nil {
+			return out, err
+		}
+	}
+	if out.calibration.Configuration != configuration {
+		return out, fmt.Errorf("calibration configuration mismatch")
+	}
+	if err := VerifyCalibration(out.calibration, cfg, out.source, gate.Digest(validationBytes)); err != nil {
+		return out, err
+	}
+	inventoryBytes, err := readFile(dir, "gate/inventory_"+configuration+".json")
+	if err != nil {
+		return out, err
+	}
+	var inventory StoreInventory
+	if err := decodeArtifact(inventoryBytes, &inventory); err != nil {
+		return out, err
+	}
+	checked, err := finishInventory(inventory)
+	if err != nil {
+		return out, err
+	}
+	if inventory.Version != 1 || inventory.Configuration != configuration || !inventory.DeclaredComplete || inventory.Unknown || inventory.Consumed || inventory.SHA256 != checked.SHA256 {
+		return out, fmt.Errorf("invalid retained migration inventory")
+	}
+	out.inputs, out.pools, err = Inputs(dir)
+	if err != nil {
+		return out, err
+	}
+	out.inputs.SourceSHA256 = out.source.Identity.SHA256
+	out.inputs.SourceBundleSHA256 = out.source.BundleSHA256
+	out.inputs.ValidationSHA256 = gate.Digest(validationBytes)
+	out.inputs.CalibrationSHA256 = gate.Digest(calibrationBytes)
+	out.inputs.InventorySHA256 = inventory.SHA256
+	out.inputs.Roles = out.validation.Profile.Roles
+	out.inputs.Profiles = freezeProfiles(out.validation.Profile)
+	out.inputs.EffectivePolicies = out.validation.EffectivePolicies
+	return out, nil
+}
+
+func buildEvidenceFreeze(configuration string, evidence freezeEvidence) (gate.Freeze, error) {
+	margins := map[string]float64{}
+	for _, selection := range evidence.calibration.Selections {
+		if selection.Status == gate.CalibrationEligible {
+			margins[selection.Variant] = selection.Margin
+		}
+	}
+	if len(margins) == 0 {
+		return gate.Freeze{}, fmt.Errorf("no calibration-eligible variant; retain the complete diagnostic calibration without an authorizing freeze")
+	}
+	policy := gate.ProposedPolicy(margins, BootstrapSeed)
+	contexts, err := scenarioContexts(configuration)
+	if err != nil {
+		return gate.Freeze{}, err
+	}
+	policies := map[string]json.RawMessage{}
+	for _, variant := range scenarios.Variants() {
+		raw, err := jsonv2.Marshal(variant.Policy, jsonv2.Deterministic(true))
+		if err != nil {
+			return gate.Freeze{}, err
+		}
+		policies[variant.ID] = raw
+	}
+	in := evidence.inputs
+	f := gate.Freeze{Format: gate.FreezeFormat, Version: 2, Configuration: configuration, Policy: &policy, Selections: evidence.calibration.Selections, Roles: in.Roles, Profiles: in.Profiles, EffectivePolicies: in.EffectivePolicies, SourceSHA256: in.SourceSHA256, SourceBundleSHA256: in.SourceBundleSHA256, ValidationSHA256: in.ValidationSHA256, InventorySHA256: in.InventorySHA256, CalibrationSHA256: in.CalibrationSHA256, SimulatorVersion: gate.SimulatorVersion, MaterializerVersion: env.MaterializerVersion, GatedScenarios: env.GatedScenarios(configuration), ReportedScenarios: env.ReportedScenarios(), ScenarioContexts: contexts, Policies: policies, Pools: evidence.pools, GitRevision: evidence.source.BaseRevision, Dirty: evidence.source.Dirty, Created: time.Now().UTC()}
+	hash, err := f.Hash()
+	if err != nil {
+		return f, err
+	}
+	return f, f.Verify(hash, in)
+}
+
+func freezeProfiles(profile longrun.ConfigurationProfile) map[string]gate.CapabilityProfile {
+	out := map[string]gate.CapabilityProfile{}
+	for _, scenario := range env.ScenarioIDs(profile.Configuration) {
+		models := []gate.RoleIdentity{profile.Roles["planner"]}
+		support := profile.Supports["planner"]
+		if scenario == "model_change" {
+			models = append(models, profile.Roles["planner_small"])
+			support = support.Intersect(profile.Supports["planner_small"])
+		}
+		parts := make([]string, 0, len(support.ImageFormats)+len(support.DocumentFormats))
+		for _, format := range support.ImageFormats {
+			parts = append(parts, "image/"+string(format))
+		}
+		for _, format := range support.DocumentFormats {
+			parts = append(parts, "document/"+string(format))
+		}
+		out[scenario] = gate.CapabilityProfile{Version: "v1", Models: models, Parts: parts}
+	}
+	return out
+}
+
+// VerifyLiveProfile resolves explicit local role choices without provider I/O.
+func VerifyLiveProfile(configuration string, expected map[string]gate.RoleIdentity) error {
+	profile, err := longrun.ResolveProfile(configuration)
+	if err != nil {
+		return err
+	}
+	if !reflect.DeepEqual(profile.Roles, expected) {
+		return fmt.Errorf("configured role identities differ from frozen evidence")
+	}
+	return nil
+}
diff --git b/integration_tests/fixtures/longrun/gate/inventory.go b/integration_tests/fixtures/longrun/gate/inventory.go
new file mode 100644
index 0000000..945973e
--- /dev/null
+++ b/integration_tests/fixtures/longrun/gate/inventory.go
@@ -0,0 +1,151 @@
+package suite
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/CaliLuke/loom-mcp/v2/eval/gate"
+	"github.com/google/uuid"
+)
+
+// InventoryFile binds every inspected regular file to its exact bytes.
+type InventoryFile struct {
+	Path   string `json:"path"`
+	SHA256 string `json:"sha256"`
+}
+
+// InventoryEntry classifies a persisted store entry, including unpublished ones.
+type InventoryEntry struct {
+	Path     string `json:"path"`
+	Kind     string `json:"kind"`
+	Unknown  bool   `json:"unknown"`
+	Consumed bool   `json:"consumed"`
+}
+
+// StoreInventory records the explicitly declared historical store boundary.
+// It cannot discover experiments in undeclared external stores.
+type StoreInventory struct {
+	Version          int              `json:"version"`
+	Configuration    string           `json:"configuration"`
+	Store            string           `json:"store"`
+	DeclaredComplete bool             `json:"declared_complete"`
+	Absent           bool             `json:"absent"`
+	Files            []InventoryFile  `json:"files"`
+	Entries          []InventoryEntry `json:"entries"`
+	Unknown          bool             `json:"unknown"`
+	Consumed         bool             `json:"consumed"`
+	Limitation       string           `json:"limitation"`
+	SHA256           string           `json:"sha256"`
+}
+
+// InventoryStore inspects the named store without creating it or hiding staged,
+// malformed or interrupted entries. A declaration is mandatory.
+func InventoryStore(dir, configuration, storePath string, declaredComplete bool) (out StoreInventory, err error) {
+	if !declaredComplete || storePath == "" || configuration == "" {
+		return out, fmt.Errorf("inventory requires an explicit named store and complete-store declaration")
+	}
+	absolute, err := filepath.Abs(storePath)
+	if err != nil {
+		return out, err
+	}
+	out = StoreInventory{Version: 1, Configuration: configuration, Store: absolute, DeclaredComplete: true, Limitation: "This declaration covers only the named store; undeclared external stores cannot be discovered. A fresh worktree alone is not historical inventory."}
+	info, err := os.Lstat(absolute)
+	if errors.Is(err, os.ErrNotExist) {
+		out.Absent = true
+		return finishInventory(out)
+	}
+	if err != nil {
+		return out, err
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		out.addEntry(".", "symlink_or_non_directory", true, false)
+		return finishInventory(out)
+	}
+	root, err := os.OpenRoot(absolute)
+	if err != nil {
+		return out, err
+	}
+	defer func() { err = errors.Join(err, root.Close()) }()
+	files := map[string][]byte{}
+	err = fs.WalkDir(root.FS(), ".", func(path string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if path == "." {
+			return nil
+		}
+		if entry.Type()&os.ModeSymlink != 0 {
+			out.addEntry(path, "symlink", true, false)
+			return nil
+		}
+		if entry.IsDir() {
+			if strings.Contains(path, "/") {
+				out.addEntry(path, "reserved_directory", true, false)
+			}
+			return nil
+		}
+		if !entry.Type().IsRegular() {
+			out.addEntry(path, "reserved", true, false)
+			return nil
+		}
+		data, readErr := root.ReadFile(path)
+		if readErr != nil {
+			return readErr
+		}
+		files[path] = data
+		out.Files = append(out.Files, InventoryFile{Path: path, SHA256: gate.Digest(data)})
+		return nil
+	})
+	if err != nil {
+		return out, err
+	}
+	entries, err := fs.ReadDir(root.FS(), ".")
+	if err != nil {
+		return out, err
+	}
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.Type()&os.ModeSymlink != 0 {
+			continue
+		}
+		switch {
+		case name == ".gitignore" && !entry.IsDir():
+		case strings.HasPrefix(name, ".experiment.tmp-"):
+			out.addEntry(name, "staging", true, false)
+		case strings.HasPrefix(name, ".experiment.json.tmp-"):
+			out.addEntry(name, "temporary_header", true, false)
+		case entry.IsDir():
+			if _, parseErr := uuid.Parse(name); parseErr != nil {
+				out.addEntry(name, "unrecognized", true, false)
+				continue
+			}
+			if err := inspectInventoryExperiment(dir, &out, name, files); err != nil {
+				return out, err
+			}
+		default:
+			out.addEntry(name, "unrecognized", true, false)
+		}
+	}
+	return finishInventory(out)
+}
+
+func finishInventory(out StoreInventory) (StoreInventory, error) {
+	out.SHA256 = ""
+	data, err := json.Marshal(out)
+	if err != nil {
+		return out, err
+	}
+	out.SHA256 = gate.Digest(data)
+	return out, nil
+}
+
+func (out *StoreInventory) addEntry(path, kind string, unknown, consumed bool) {
+	out.Entries = append(out.Entries, InventoryEntry{Path: path, Kind: kind, Unknown: unknown, Consumed: consumed})
+	out.Unknown = out.Unknown || unknown
+	out.Consumed = out.Consumed || consumed
+}
diff --git b/integration_tests/fixtures/longrun/gate/inventory_scan.go b/integration_tests/fixtures/longrun/gate/inventory_scan.go
new file mode 100644
index 0000000..54bd8b0
--- /dev/null
+++ b/integration_tests/fixtures/longrun/gate/inventory_scan.go
@@ -0,0 +1,227 @@
+package suite
+
+import (
+	"bytes"
+	stdjson "encoding/json"
+	"encoding/json/v2"
+	"errors"
+	"example.com/longrun/env"
+	"fmt"
+	"github.com/CaliLuke/loom-mcp/v2/eval/gate"
+	"maps"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"github.com/CaliLuke/loom-mcp/v2/eval"
+)
+
+type inventoryAttempt struct {
+	Key          string `json:"key"`
+	Index        int    `json:"index"`
+	Verdict      string `json:"verdict"`
+	Variant      string `json:"variant"`
+	Scenario     string `json:"scenario"`
+	Item         string `json:"item"`
+	Repeat       int    `json:"repeat"`
+	HarnessError string `json:"harness_error"`
+	Error        string `json:"error"`
+	NotRun       string `json:"not_run"`
+	StorageError string `json:"storage_error"`
+}
+
+func inspectInventoryExperiment(dir string, out *StoreInventory, id string, files map[string][]byte) error {
+	headerBytes, ok := files[id+"/experiment.json"]
+	if !ok {
+		out.addEntry(id, "orphan", true, false)
+		return nil
+	}
+	header, decodeErr := eval.DecodeExperimentHeader(headerBytes, id)
+	if decodeErr != nil {
+		out.addEntry(id, "invalid_header", true, false)
+		return inventoryRecordedUnknown(out)
+	}
+	for _, path := range slices.Sorted(maps.Keys(files)) {
+		if !strings.HasPrefix(path, id+"/") || path == id+"/experiment.json" || path == id+"/attempts.jsonl" {
+			continue
+		}
+		kind := "unrecognized"
+		if strings.HasPrefix(filepath.Base(path), ".experiment.json.tmp-") {
+			kind = "temporary_header"
+		}
+		out.addEntry(path, kind, true, false)
+	}
+	if header.Status == "running" {
+		out.addEntry(id, "running", true, false)
+	} else if header.Status != "complete" {
+		out.addEntry(id, "partial", true, false)
+	}
+	data, ok := files[id+"/attempts.jsonl"]
+	if !ok {
+		out.addEntry(id, "partial", true, false)
+		return nil
+	}
+	lines := bytes.Split(data, []byte{'\n'})
+	var first struct {
+		Format     string `json:"format"`
+		Version    int    `json:"version"`
+		Experiment string `json:"experiment"`
+	}
+	if len(lines) == 0 || json.Unmarshal(lines[0], &first) != nil || first.Format != "loom-mcp.eval.attempts" || first.Version != 1 || first.Experiment != id {
+		out.addEntry(id, "invalid_attempt_header", true, false)
+		return inventoryRecordedUnknown(out)
+	}
+	heldout, err := inventoryHeldout(dir, out.Configuration)
+	if err != nil {
+		return err
+	}
+	seen := map[eval.AttemptKey]bool{}
+	count := 0
+	for index, line := range lines[1:] {
+		if len(bytes.TrimSpace(line)) == 0 && index == len(lines)-2 {
+			continue
+		}
+		var a inventoryAttempt
+		if json.Unmarshal(line, &a) != nil || a.Variant == "" || a.Scenario == "" || a.Item == "" || a.Repeat < 1 {
+			out.addEntry(id, "partial_attempt", true, false)
+			continue
+		}
+		key := eval.AttemptKey{Variant: a.Variant, Scenario: a.Scenario, Item: a.Item, Repeat: a.Repeat}
+		if a.Key != key.String() || a.Index < 0 || !slices.Contains([]string{"passed", "failed", "error", "pending", "not_run"}, a.Verdict) {
+			out.addEntry(id, "partial_attempt", true, false)
+		}
+		if a.Verdict == "error" || a.Verdict == "pending" || a.Verdict == "not_run" {
+			out.addEntry(id, "partial_attempt", true, false)
+		}
+		if seen[key] {
+			out.addEntry(id, "duplicate_attempt", true, false)
+		}
+		seen[key] = true
+		count++
+		if a.HarnessError != "" || a.Error != "" || a.NotRun != "" || a.StorageError != "" {
+			out.addEntry(id, "partial_attempt", true, false)
+		}
+		config, known := inventoryConfiguration(header.Label)
+		if !known || len(heldout) == 0 {
+			out.addEntry(id, "unknown_consumption", true, false)
+		}
+		if known && config == out.Configuration && config != "offline" && a.Variant != "baseline" && heldout[a.Scenario+"/"+a.Item] {
+			out.addEntry(id, "heldout_variant", false, true)
+		}
+	}
+	if header.Planned < 1 || count != header.Planned {
+		out.addEntry(id, "partial", true, false)
+	} else if header.Status == "complete" {
+		out.addEntry(id, "complete", false, false)
+	}
+	return nil
+}
+
+func inventoryConfiguration(label string) (string, bool) {
+	parts := strings.Split(label, "/")
+	if len(parts) >= 2 && (parts[0] == "gate" || parts[0] == "pilot") {
+		switch parts[1] {
+		case "offline", "anthropic", "bedrock-anthropic", "openai", "gemini":
+			return parts[1], true
+		}
+	}
+	return "", false
+}
+
+func inventoryHeldout(dir, configuration string) (map[string]bool, error) {
+	frozen, err := inventoryFrozenPools(dir, configuration)
+	if err != nil {
+		return nil, err
+	}
+	out := map[string]bool{}
+	for _, scenario := range env.ScenarioIDs(configuration) {
+		for _, part := range []struct {
+			name  string
+			count int
+		}{{"look1", 12}, {"look2", 12}, {"look3", 24}} {
+			pool, err := LoadPool(dir, scenario, part.name)
+			if err != nil {
+				return nil, fmt.Errorf("inventory complete heldout manifest: %w", err)
+			}
+			items := pool.Items()
+			if len(items) != part.count {
+				return nil, fmt.Errorf("inventory heldout count mismatch: %s/%s", scenario, part.name)
+			}
+			if frozen != nil {
+				key := scenario + "/" + part.name
+				want, ok := frozen[key]
+				if !ok || len(want.Items) != part.count {
+					return nil, fmt.Errorf("inventory frozen heldout manifest missing %s", key)
+				}
+				raw, err := readFile(dir, "testdata/pools/"+key+".jsonl")
+				if err != nil {
+					return nil, err
+				}
+				if gate.Digest(raw) != want.DatasetHash {
+					return nil, fmt.Errorf("inventory frozen heldout bytes changed: %s", key)
+				}
+				for i, item := range items {
+					if item.ID != want.Items[i].ID {
+						return nil, fmt.Errorf("inventory frozen heldout identity changed: %s", key)
+					}
+				}
+			}
+			for _, item := range items {
+				key := scenario + "/" + item.ID
+				if out[key] {
+					return nil, fmt.Errorf("inventory duplicate heldout item %s", key)
+				}
+				out[key] = true
+			}
+		}
+	}
+	return out, nil
+}
+
+func inventoryFrozenPools(dir, configuration string) (map[string]gate.Pool, error) {
+	paths := []string{freezePath(dir, configuration)}
+	if configuration != "offline" {
+		paths = append(paths, freezePath(dir, "offline"))
+	}
+	for _, path := range paths {
+		data, err := readFile(filepath.Dir(path), filepath.Base(path))
+		if errors.Is(err, os.ErrNotExist) {
+			continue
+		}
+		if err != nil {
+			return nil, err
+		}
+		var f gate.Freeze
+		if err := stdjson.Unmarshal(data, &f); err != nil {
+			return nil, err
+		}
+		hash, err := f.Hash()
+		if err != nil {
+			return nil, err
+		}
+		expected, err := os.ReadFile(strings.TrimSuffix(path, ".json") + ".sha256")
+		if err != nil || hash != strings.TrimSpace(string(expected)) || f.Format != gate.FreezeFormat || (f.Version != 1 && f.Version != 2) {
+			return nil, fmt.Errorf("inventory requires an intact frozen pool manifest: %s", path)
+		}
+		out := map[string]gate.Pool{}
+		for _, pool := range f.Pools {
+			key := pool.Scenario + "/" + pool.Partition
+			if _, exists := out[key]; exists {
+				return nil, fmt.Errorf("inventory duplicate frozen pool %s", key)
+			}
+			out[key] = pool
+		}
+		return out, nil
+	}
+	return nil, nil
+}
+
+// A malformed entry is evidence, not a failed inventory scan. Completion remains
+// fail-closed through Unknown; never lose that marker while collecting entries.
+func inventoryRecordedUnknown(out *StoreInventory) error {
+	if !out.Unknown {
+		return fmt.Errorf("invalid inventory entry lost its unknown marker")
+	}
+	return nil
+}
diff --git b/integration_tests/fixtures/longrun/gate/look_plan.go b/integration_tests/fixtures/longrun/gate/look_plan.go
new file mode 100644
index 0000000..b208f64
--- /dev/null
+++ b/integration_tests/fixtures/longrun/gate/look_plan.go
@@ -0,0 +1,49 @@
+package suite
+
+import (
+	"github.com/CaliLuke/loom-mcp/v2/eval"
+	"github.com/CaliLuke/loom-mcp/v2/eval/gate"
+)
+
+// LookWork is the exact work allowed by a verified policy and its stored prefix.
+// Keys is nonnil only for a same-look infrastructure rerun.
+type LookWork struct {
+	Variants []string
+	Keys     []eval.AttemptKey
+	Rerun    bool
+}
+
+// PlanLook validates scheduling before any experiment or harness is created.
+func PlanLook(policy *gate.Policy, look int, previous []gate.Decision) (LookWork, error) {
+	if err := gate.ValidateNextLook(policy, look, previous); err != nil {
+		return LookWork{}, err
+	}
+	work := LookWork{Variants: []string{"baseline"}}
+	active := map[string]bool{}
+	for name := range policy.Unsupported {
+		active[name] = true
+	}
+	if len(previous) > 0 {
+		last := previous[len(previous)-1]
+		if last.Status == gate.Incomplete {
+			work.Rerun = true
+			work.Keys = make([]eval.AttemptKey, 0, len(last.Rerun))
+			for _, key := range last.Rerun {
+				work.Keys = append(work.Keys, eval.AttemptKey{Variant: key.Variant, Scenario: key.Scenario, Item: key.Item, Repeat: key.Repeat})
+			}
+		} else {
+			for _, v := range last.Variants {
+				active[v.Variant] = v.Status == gate.Continue
+			}
+		}
+	}
+	for _, name := range []string{"receipt_only", "hybrid"} {
+		if active[name] {
+			work.Variants = append(work.Variants, name)
+		}
+	}
+	if look == 1 {
+		work.Variants = append(work.Variants, "clear_only")
+	}
+	return work, nil
+}
diff --git b/integration_tests/fixtures/longrun/gate/pilot_evidence.go b/integration_tests/fixtures/longrun/gate/pilot_evidence.go
new file mode 100644
index 0000000..ada2fea
--- /dev/null
+++ b/integration_tests/fixtures/longrun/gate/pilot_evidence.go
@@ -0,0 +1,111 @@
+package suite
+
+import (
+	"fmt"
+	"reflect"
+
+	"example.com/longrun"
+	"example.com/longrun/env"
+	"example.com/longrun/fake"
+	"github.com/CaliLuke/loom-mcp/v2/eval"
+	"github.com/CaliLuke/loom-mcp/v2/eval/gate"
+	"github.com/google/uuid"
+)
+
+// PilotObservation preserves one validated baseline outcome and observed models.
+type PilotObservation struct {
+	Key         eval.AttemptKey   `json:"key"`
+	Success     bool              `json:"success"`
+	Unsupported bool              `json:"unsupported"`
+	Evidence    bool              `json:"evidence"`
+	Models      map[string]string `json:"models"`
+	Error       string            `json:"error,omitempty"`
+}
+
+// PilotEvidence binds a complete baseline-only pilot to source and role choices.
+type PilotEvidence struct {
+	Version          int                          `json:"version"`
+	Configuration    string                       `json:"configuration"`
+	ExperimentID     string                       `json:"experiment_id"`
+	ExperimentSHA256 string                       `json:"experiment_sha256"`
+	SourceSHA256     string                       `json:"source_sha256"`
+	Profile          longrun.ConfigurationProfile `json:"profile"`
+	Rows             []PilotObservation           `json:"rows"`
+}
+
+// VerifyPilot requires the exact two-repeat pilot manifest and recorded roles.
+func VerifyPilot(dir, configuration string, pilot PilotEvidence, profile longrun.ConfigurationProfile, sourceSHA string) (map[string]gate.Rates, error) {
+	if pilot.Version != 1 || pilot.Configuration != configuration || profile.Configuration != configuration || !reflect.DeepEqual(pilot.Profile, profile) || !sourceHex(sourceSHA, 32) || pilot.SourceSHA256 != sourceSHA || !sourceHex(pilot.ExperimentSHA256, 32) {
+		return nil, fmt.Errorf("pilot source or model profile mismatch")
+	}
+	if _, err := uuid.Parse(pilot.ExperimentID); err != nil {
+		return nil, fmt.Errorf("invalid pilot experiment identity: %w", err)
+	}
+	if _, err := longrun.ProfileConfiguration(profile, fake.Faults{}); err != nil {
+		return nil, err
+	}
+	expected, err := pilotItems(dir, configuration)
+	if err != nil {
+		return nil, err
+	}
+	if len(pilot.Rows) != len(expected)*2 {
+		return nil, fmt.Errorf("pilot requires the complete two-repeat baseline manifest")
+	}
+	seen := map[eval.AttemptKey]bool{}
+	rates := map[string]gate.Rates{}
+	for _, row := range pilot.Rows {
+		if _, ok := expected[row.Key.Scenario+"/"+row.Key.Item]; !ok || row.Key.Variant != "baseline" || row.Key.Repeat < 1 || row.Key.Repeat > 2 || seen[row.Key] || row.Error != "" {
+			return nil, fmt.Errorf("invalid, duplicate or infrastructure-failed pilot row %s", row.Key.String())
+		}
+		seen[row.Key] = true
+		if row.Models["planner"] != profile.Roles["planner"].Normalized {
+			return nil, fmt.Errorf("pilot lacks the configured planner identity")
+		}
+		for role, observed := range row.Models {
+			want, ok := profile.Roles[role]
+			if !ok || observed != want.Normalized {
+				return nil, fmt.Errorf("pilot observed model identity differs for %s", role)
+			}
+		}
+		rate := rates[row.Key.Scenario]
+		if row.Success {
+			rate.Success++
+		}
+		if row.Unsupported {
+			rate.Unsupported++
+		}
+		if row.Evidence {
+			rate.Evidence++
+		}
+		rates[row.Key.Scenario] = rate
+	}
+	for _, scenario := range env.GatedScenarios(configuration) {
+		rate := rates[scenario]
+		rate.Success /= 12
+		rate.Unsupported /= 12
+		rate.Evidence /= 12
+		rates[scenario] = rate
+	}
+	return rates, nil
+}
+
+func pilotItems(dir, configuration string) (map[string]eval.Item, error) {
+	items := map[string]eval.Item{}
+	for _, scenario := range env.GatedScenarios(configuration) {
+		pool, err := LoadPool(dir, scenario, "pilot")
+		if err != nil {
+			return nil, err
+		}
+		if len(pool.Items()) != 6 {
+			return nil, fmt.Errorf("pilot requires six items for %s", scenario)
+		}
+		for _, item := range pool.Items() {
+			key := scenario + "/" + item.ID
+			if _, ok := items[key]; ok {
+				return nil, fmt.Errorf("duplicate pilot pool item %s", key)
+			}
+			items[key] = item
+		}
+	}
+	return items, nil
+}
diff --git b/integration_tests/fixtures/longrun/gate/pilot_store.go b/integration_tests/fixtures/longrun/gate/pilot_store.go
new file mode 100644
index 0000000..64b80b8
--- /dev/null
+++ b/integration_tests/fixtures/longrun/gate/pilot_store.go
@@ -0,0 +1,138 @@
+package suite
+
+import (
+	"encoding/json"
+	"fmt"
+	"path/filepath"
+	"reflect"
+
+	"example.com/longrun"
+	"github.com/CaliLuke/loom-mcp/v2/eval"
+	"github.com/CaliLuke/loom-mcp/v2/eval/gate"
+	"github.com/CaliLuke/loom-mcp/v2/runtime/agent/model"
+	"github.com/google/uuid"
+)
+
+// WritePilotEvidence retains the verified complete pilot projection once.
+func WritePilotEvidence(dir, configuration string, experiment *eval.Experiment, profile longrun.ConfigurationProfile, sourceSHA string) (PilotEvidence, error) {
+	evidence, err := buildPilotEvidence(dir, configuration, experiment, profile, sourceSHA)
+	if err != nil {
+		return evidence, err
+	}
+	data, err := json.MarshalIndent(evidence, "", "  ")
+	if err != nil {
+		return evidence, err
+	}
+	return evidence, writeOnce(pilotPath(dir, configuration, evidence.ExperimentID), append(data, '\n'))
+}
+
+// ReadPilotEvidence checks retained roles, observations and the current immutable export.
+func ReadPilotEvidence(dir, configuration string, experiment *eval.Experiment, profile longrun.ConfigurationProfile, sourceSHA string) (PilotEvidence, error) {
+	var evidence PilotEvidence
+	if experiment == nil {
+		return evidence, fmt.Errorf("missing pilot experiment")
+	}
+	if _, err := uuid.Parse(experiment.Header.ID); err != nil {
+		return evidence, err
+	}
+	if err := validateConfigurationName(configuration); err != nil {
+		return evidence, err
+	}
+	data, err := readFile(dir, filepath.Join("gate", filepath.Base(pilotPath(dir, configuration, experiment.Header.ID))))
+	if err != nil {
+		return evidence, err
+	}
+	if err := decodeArtifact(data, &evidence); err != nil {
+		return evidence, err
+	}
+	current, err := buildPilotEvidence(dir, configuration, experiment, profile, sourceSHA)
+	if err != nil {
+		return evidence, err
+	}
+	if !reflect.DeepEqual(evidence, current) {
+		return evidence, fmt.Errorf("pilot export or recorded identity changed")
+	}
+	return evidence, nil
+}
+
+func buildPilotEvidence(dir, configuration string, experiment *eval.Experiment, profile longrun.ConfigurationProfile, sourceSHA string) (PilotEvidence, error) {
+	var out PilotEvidence
+	if experiment == nil || experiment.TruncatedTail {
+		return out, fmt.Errorf("pilot is missing or truncated")
+	}
+	h := experiment.Header
+	if h.Label != "pilot/"+configuration || h.Status != "complete" || h.Parent != "" || h.RunError != "" || h.Stop != "" || h.Config.Repeats != 2 || len(h.Variants) != 1 || h.Variants[0].ID != "baseline" || h.Planned != len(experiment.Attempts) {
+		return out, fmt.Errorf("pilot header is not a complete baseline-only experiment")
+	}
+	items, err := pilotItems(dir, configuration)
+	if err != nil {
+		return out, err
+	}
+	rows := make([]eval.StoredAttempt, len(experiment.Attempts))
+	for i, attempt := range experiment.Attempts {
+		if attempt == nil {
+			return out, fmt.Errorf("pilot contains a missing attempt")
+		}
+		rows[i] = *attempt
+	}
+	table, err := gate.FromStored(rows)
+	if err != nil {
+		return out, err
+	}
+	out = PilotEvidence{Version: 1, Configuration: configuration, ExperimentID: h.ID, Profile: profile, SourceSHA256: sourceSHA}
+	for i, row := range table {
+		if row.Infrastructure || len(rows[i].Runs) == 0 {
+			return out, fmt.Errorf("pilot has infrastructure failures or absent run evidence")
+		}
+		item, ok := items[row.Scenario+"/"+row.Item]
+		if !ok {
+			return out, fmt.Errorf("pilot contains an item outside its partition")
+		}
+		if err := VerifyMeasures(rows[i], item); err != nil {
+			return out, err
+		}
+		models, err := pilotModels(rows[i], profile)
+		if err != nil {
+			return out, err
+		}
+		out.Rows = append(out.Rows, PilotObservation{Key: rows[i].AttemptKey, Success: row.Success, Unsupported: row.Unsupported, Evidence: row.Evidence, Models: models})
+	}
+	data, err := json.Marshal(struct {
+		Header   eval.ExperimentHeader
+		Attempts []*eval.StoredAttempt
+	}{h, experiment.Attempts})
+	if err != nil {
+		return out, err
+	}
+	out.ExperimentSHA256 = gate.Digest(data)
+	_, err = VerifyPilot(dir, configuration, out, profile, sourceSHA)
+	return out, err
+}
+
+func pilotModels(attempt eval.StoredAttempt, profile longrun.ConfigurationProfile) (map[string]string, error) {
+	observed := map[string]string{}
+	for _, stored := range attempt.Runs {
+		record, err := stored.Record()
+		if err != nil {
+			return nil, err
+		}
+		for _, run := range record.Runs {
+			for _, call := range run.Calls {
+				role, ok := profile.Roles[call.Started.ModelID]
+				if !ok || call.Completion == nil || call.Completion.Facts == nil {
+					return nil, fmt.Errorf("pilot lacks complete observed role identity")
+				}
+				facts := call.Completion.Facts
+				if facts.ProviderConfig != role.Provider || model.NormalizeProviderModel(role.Provider, facts.Model) != role.Normalized {
+					return nil, fmt.Errorf("pilot observed model differs from declared role %s", call.Started.ModelID)
+				}
+				observed[call.Started.ModelID] = role.Normalized
+			}
+		}
+	}
+	return observed, nil
+}
+
+func pilotPath(dir, configuration, id string) string {
+	return filepath.Join(dir, "gate", "pilot_"+configuration+"_"+id+".json")
+}
