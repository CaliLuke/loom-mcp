@@ -0,0 +1,40 @@
+package suite
+
+import (
+	"encoding/json"
+	"path/filepath"
+)
+
+// ValidationPath separates each declared profile's v2 evidence from the v1 archive.
+func ValidationPath(dir, configuration string) string {
+	return filepath.Join(dir, "gate", "validation_"+configuration+".json")
+}
+
+// WriteValidation retains successful or failed structural evidence once.
+// ReadValidationFor refuses failed evidence as calibration input.
+func WriteValidation(dir string, validation Validation) error {
+	if err := validateConfigurationName(validation.Configuration); err != nil {
+		return err
+	}
+	data, err := json.MarshalIndent(validation, "", "  ")
+	if err != nil {
+		return err
+	}
+	return writeOnce(ValidationPath(dir, validation.Configuration), append(data, '\n'))
+}
+
+// ReadValidationFor verifies the complete current configuration manifest.
+func ReadValidationFor(dir, configuration string) (Validation, error) {
+	var validation Validation
+	if err := validateConfigurationName(configuration); err != nil {
+		return validation, err
+	}
+	data, err := readFile(dir, filepath.Join("gate", filepath.Base(ValidationPath(dir, configuration))))
+	if err != nil {
+		return validation, err
+	}
+	if err := decodeArtifact(data, &validation); err != nil {
+		return validation, err
+	}
+	return validation, VerifyValidation(dir, configuration, validation)
+}
diff --git b/integration_tests/fixtures/longrun/gate/validation_manifest.go b/integration_tests/fixtures/longrun/gate/validation_manifest.go
new file mode 100644
index 0000000..6aab6ac
--- /dev/null
+++ b/integration_tests/fixtures/longrun/gate/validation_manifest.go
@@ -0,0 +1,157 @@
+package suite
+
+import (
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"slices"
+
+	"example.com/longrun"
+	"example.com/longrun/env"
+	"example.com/longrun/fake"
+	"example.com/longrun/scenarios"
+	"github.com/CaliLuke/loom-mcp/v2/eval"
+	"github.com/CaliLuke/loom-mcp/v2/eval/gate"
+)
+
+// ValidationRow records one required structural attempt without borrowing live evidence.
+type ValidationRow struct {
+	Key             eval.AttemptKey `json:"key"`
+	Partition       string          `json:"partition"`
+	EvidencePresent bool            `json:"evidence_present"`
+	Qualifying      bool            `json:"qualifying"`
+	Failure         string          `json:"failure,omitempty"`
+}
+
+type validationExpectation struct {
+	partition, agent string
+}
+
+// VerifyValidation requires complete, unique structural evidence for the configuration.
+func VerifyValidation(dir, configuration string, validation Validation) error {
+	if validation.Version != 2 || validation.Configuration != configuration || validation.Profile.Configuration != configuration || validation.Repeats != 1 || validation.MaterializerVersion != env.MaterializerVersion {
+		return fmt.Errorf("unsupported or mismatched validation configuration")
+	}
+	if _, err := longrun.ProfileConfiguration(validation.Profile, fake.Faults{}); err != nil {
+		return err
+	}
+	source, err := hex.DecodeString(validation.SourceSHA256)
+	if err != nil || len(source) != 32 {
+		return fmt.Errorf("validation has no source identity")
+	}
+	_, pools, err := Inputs(dir)
+	if err != nil {
+		return err
+	}
+	raw, err := json.Marshal(pools)
+	if err != nil {
+		return err
+	}
+	if validation.PoolsSHA256 != gate.Digest(raw) {
+		return fmt.Errorf("validation pool identity mismatch")
+	}
+	expected, policies, err := validationManifest(dir, configuration, pools)
+	if err != nil {
+		return err
+	}
+	if len(validation.Failures) > 0 || validation.Attempts != len(expected) || len(validation.Rows) != len(expected) {
+		return fmt.Errorf("validation is incomplete or structurally failed")
+	}
+	seen := make(map[eval.AttemptKey]bool, len(expected))
+	totals := map[string]map[string]int{"receipt_only": {}, "hybrid": {}}
+	qualifying := map[string]map[string]float64{"receipt_only": {}, "hybrid": {}}
+	for _, row := range validation.Rows {
+		want, ok := expected[row.Key]
+		if !ok || seen[row.Key] || row.Partition != want.partition || row.Failure != "" {
+			return fmt.Errorf("invalid validation observation %s", row.Key.String())
+		}
+		if validationResident(validation.Profile, row.Key) && !row.EvidencePresent {
+			return fmt.Errorf("resident multimodal validation lacks original evidence: %s", row.Key.String())
+		}
+		seen[row.Key] = true
+		if byScenario, ok := totals[row.Key.Variant]; ok && slices.Contains(env.GatedScenarios(configuration), row.Key.Scenario) {
+			byScenario[row.Key.Scenario]++
+			if row.Qualifying {
+				qualifying[row.Key.Variant][row.Key.Scenario]++
+			}
+		}
+	}
+	for variant, counts := range totals {
+		for _, scenario := range env.GatedScenarios(configuration) {
+			if counts[scenario] == 0 {
+				return fmt.Errorf("validation lacks %s/%s", variant, scenario)
+			}
+			qualifying[variant][scenario] /= float64(counts[scenario])
+		}
+	}
+	if !reflect.DeepEqual(qualifying, validation.Qualifying) {
+		return fmt.Errorf("validation qualifying fractions differ from complete observations")
+	}
+	if len(policies) != len(validation.EffectivePolicies) {
+		return fmt.Errorf("validation effective policy manifest is incomplete")
+	}
+	for key := range policies {
+		raw, ok := validation.EffectivePolicies[key]
+		if !ok {
+			return fmt.Errorf("validation lacks effective policy %s", key)
+		}
+		if err := verifyValidationPolicy(key, raw); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// validationManifest enumerates required partitions independently of filesystem discovery.
+func validationManifest(dir, configuration string, pools []gate.Pool) (map[eval.AttemptKey]validationExpectation, map[string]bool, error) {
+	expected := make(map[eval.AttemptKey]validationExpectation)
+	policies := make(map[string]bool)
+	byName := make(map[string]gate.Pool, len(pools))
+	for _, pool := range pools {
+		byName[pool.Scenario+"/"+pool.Partition] = pool
+	}
+	for _, scenario := range env.ScenarioIDs(configuration) {
+		for _, part := range []struct {
+			name  string
+			count int
+		}{{"pilot", 6}, {"look1", 12}, {"look2", 12}, {"look3", 24}, {"smoke", 3}} {
+			if scenario == "model_change" && part.name == "pilot" {
+				continue
+			}
+			pool, ok := byName[scenario+"/"+part.name]
+			if !ok || len(pool.Items) != part.count {
+				return nil, nil, fmt.Errorf("missing or incomplete validation pool %s/%s", scenario, part.name)
+			}
+			dataset, err := LoadPool(dir, scenario, part.name)
+			if err != nil {
+				return nil, nil, err
+			}
+			for _, item := range dataset.Items() {
+				var parameters env.Parameters
+				if err := json.Unmarshal(item.Data, &parameters); err != nil {
+					return nil, nil, err
+				}
+				if parameters.Scenario != scenario {
+					return nil, nil, fmt.Errorf("validation item scenario differs from pool")
+				}
+				agent := "longrun." + parameters.Template
+				if scenario == "no_summariser" {
+					agent += "_nosum"
+				}
+				if scenario == "summariser_rejected" {
+					agent += "_reject"
+				}
+				for _, variant := range scenarios.Variants() {
+					key := eval.AttemptKey{Variant: variant.ID, Scenario: scenario, Item: item.ID, Repeat: 1}
+					if _, exists := expected[key]; exists {
+						return nil, nil, fmt.Errorf("duplicate validation item %s", key.String())
+					}
+					expected[key] = validationExpectation{partition: part.name, agent: agent}
+					policies[scenario+"/"+variant.ID+"/"+agent] = true
+				}
+			}
+		}
+	}
+	return expected, policies, nil
+}
diff --git b/integration_tests/fixtures/longrun/gate/validation_policy.go b/integration_tests/fixtures/longrun/gate/validation_policy.go
new file mode 100644
index 0000000..117c9c1
--- /dev/null
+++ b/integration_tests/fixtures/longrun/gate/validation_policy.go
@@ -0,0 +1,63 @@
+package suite
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"example.com/longrun"
+	"example.com/longrun/scenarios"
+	"github.com/CaliLuke/loom-mcp/v2/eval"
+	"github.com/CaliLuke/loom-mcp/v2/runtime/agent/api"
+	"github.com/CaliLuke/loom-mcp/v2/runtime/agent/compaction"
+	"github.com/CaliLuke/loom-mcp/v2/runtime/agent/prompt"
+)
+
+// This content identity pins the runtime's embedded summary_prompt.tmpl. A
+// template change must update this contract and invalidate validation evidence.
+const validationSummaryTemplate = "sha256:c213a63837087dad5fb990d74a4fea84f0072c70f4455cce27e9a646268aef95"
+
+// expectedValidationPolicy resolves budget defaults through their public owner.
+// Registration-owned summary semantics remain explicit fixture requirements.
+func expectedValidationPolicy(scenario, variant, agent string) json.RawMessage {
+	registered := compaction.Settings{}
+	if !strings.HasSuffix(agent, "_nosum") {
+		registered.Summary = compaction.SummaryConfig{Enabled: true, Model: compaction.ContextModel{ID: "summariser"}, Settings: compaction.SummarySettings{Instructions: "Keep planted key = value lines verbatim in order. Later corrections override earlier values."}}
+		if strings.HasSuffix(agent, "_reject") {
+			registered.Summary.Settings.Instructions += " [[force-summary-rejection]]"
+		}
+	}
+	registered.Prompt = compaction.SummaryPrompt{Ref: prompt.PromptRef{ID: prompt.Ident(agent + ".context.summary"), Version: validationSummaryTemplate}, Template: validationSummaryTemplate}
+	for _, candidate := range scenarios.Variants() {
+		if candidate.ID != variant {
+			continue
+		}
+		input := &api.RunInput{Policy: candidate.Policy}
+		scenarios.ContextFor(scenario).Apply()(input)
+		return compaction.Canonical(compaction.Merge(registered, input.Policy.Context))
+	}
+	panic("unknown validation variant: " + variant)
+}
+
+func verifyValidationPolicy(key string, raw json.RawMessage) error {
+	parts := strings.Split(key, "/")
+	if len(parts) != 3 {
+		return fmt.Errorf("invalid effective policy key %s", key)
+	}
+	var settings compaction.Settings
+	if err := compaction.DecodeCanonical(raw, &settings); err != nil {
+		return fmt.Errorf("validation effective policy %s: %w", key, err)
+	}
+	if !bytes.Equal(compaction.Canonical(settings), expectedValidationPolicy(parts[0], parts[1], parts[2])) {
+		return fmt.Errorf("validation effective policy differs from required defaults and fixture overrides: %s", key)
+	}
+	return nil
+}
+
+// The full manifest derives this obligation from the validated profile, never
+// from an optional marker supplied by an individual observation.
+func validationResident(profile longrun.ConfigurationProfile, key eval.AttemptKey) bool {
+	support := profile.Supports["planner"]
+	return strings.HasPrefix(key.Scenario, "multimodal_") && key.Variant != "baseline" && support.MaxImageBytes == 0 && support.MaxDocumentBytes == 0
+}
