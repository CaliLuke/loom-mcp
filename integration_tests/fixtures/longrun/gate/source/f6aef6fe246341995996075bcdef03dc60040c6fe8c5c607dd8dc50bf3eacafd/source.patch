diff --git b/integration_tests/fixtures/longrun/gate/provenance.go b/integration_tests/fixtures/longrun/gate/provenance.go
new file mode 100644
index 0000000..24bc341
--- /dev/null
+++ b/integration_tests/fixtures/longrun/gate/provenance.go
@@ -0,0 +1,186 @@
+package suite
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// WriteSource records recoverable source only after binding the running CLI to it.
+func WriteSource(ctx context.Context, dir, configuration, base string) (SourceManifest, error) {
+	if err := validateConfigurationName(configuration); err != nil {
+		return SourceManifest{}, err
+	}
+	path := sourceManifestPath(dir, configuration)
+	if _, err := os.Stat(path); err == nil {
+		return SourceManifest{}, fmt.Errorf("source manifest already exists")
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return SourceManifest{}, err
+	}
+	root, err := EvidenceRoot(dir)
+	if err != nil {
+		return SourceManifest{}, err
+	}
+	if err := VerifyEvidenceExecutable(ctx, dir); err != nil {
+		return SourceManifest{}, err
+	}
+	manifest, bundle, err := BuildSourceManifest(ctx, root, configuration, base)
+	if err != nil {
+		return manifest, err
+	}
+	bundlePath := sourceBundlePath(manifest.Identity.SHA256)
+	if err := writeOnce(filepath.Join(dir, bundlePath), bundle); err != nil {
+		if !errors.Is(err, os.ErrExist) {
+			return manifest, err
+		}
+		retained, readErr := readFile(dir, bundlePath)
+		if readErr != nil {
+			return manifest, readErr
+		}
+		if !bytes.Equal(retained, bundle) {
+			return manifest, fmt.Errorf("retained source bundle differs")
+		}
+	}
+	data, err := json.MarshalIndent(manifest, "", "  ")
+	if err != nil {
+		return manifest, err
+	}
+	return manifest, writeOnce(path, append(data, '\n'))
+}
+
+// ReadSource verifies retained source and its recovery bundle against current owners.
+func ReadSource(ctx context.Context, dir, configuration string) (SourceManifest, error) {
+	var manifest SourceManifest
+	if err := validateConfigurationName(configuration); err != nil {
+		return manifest, err
+	}
+	data, err := readFile(dir, filepath.Join("gate", filepath.Base(sourceManifestPath(dir, configuration))))
+	if err != nil {
+		return manifest, err
+	}
+	if err := decodeArtifact(data, &manifest); err != nil {
+		return manifest, err
+	}
+	if manifest.Configuration != configuration || !sourceHex(manifest.Identity.SHA256, 32) || (!sourceHex(manifest.BaseRevision, 20) && !sourceHex(manifest.BaseRevision, 32)) {
+		return manifest, fmt.Errorf("malformed or mismatched source provenance")
+	}
+	bundle, err := readFile(dir, sourceBundlePath(manifest.Identity.SHA256))
+	if err != nil {
+		return manifest, err
+	}
+	root, err := EvidenceRoot(dir)
+	if err != nil {
+		return manifest, err
+	}
+	if err := VerifySourceManifest(ctx, root, manifest, bundle); err != nil {
+		return manifest, err
+	}
+	return manifest, nil
+}
+
+// EvidenceRoot resolves the owning repository from its exact longrun fixture path.
+func EvidenceRoot(dir string) (string, error) {
+	absolute, err := filepath.Abs(dir)
+	if err != nil {
+		return "", err
+	}
+	absolute, err = filepath.EvalSymlinks(absolute)
+	if err != nil {
+		return "", err
+	}
+	root := filepath.Clean(filepath.Join(absolute, "../../.."))
+	if filepath.Join(root, "integration_tests/fixtures/longrun") != absolute {
+		return "", fmt.Errorf("evidence requires the owning longrun fixture directory")
+	}
+	if _, err := os.Stat(filepath.Join(root, "go.work")); err != nil {
+		return "", err
+	}
+	return root, nil
+}
+
+// VerifyEvidenceExecutable refuses stale or unsupported binaries before artifact writes.
+func VerifyEvidenceExecutable(ctx context.Context, dir string) error {
+	root, err := EvidenceRoot(dir)
+	if err != nil {
+		return err
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		return err
+	}
+	return VerifySourceExecutable(ctx, root, executable)
+}
+
+func sourceManifestPath(dir, configuration string) string {
+	return filepath.Join(dir, "gate", "source_"+configuration+".json")
+}
+func sourceBundlePath(digest string) string {
+	return filepath.Join("gate", "source", digest, "source.patch")
+}
+func sourceHex(value string, size int) bool {
+	decoded, err := hex.DecodeString(value)
+	return err == nil && len(decoded) == size
+}
+func validateConfigurationName(configuration string) error {
+	switch configuration {
+	case "offline", "anthropic", "bedrock-anthropic", "openai", "gemini":
+		return nil
+	default:
+		return fmt.Errorf("unknown provider configuration %q", configuration)
+	}
+}
+func decodeArtifact(data []byte, target any) error {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(target); err != nil {
+		return err
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		if err == nil {
+			return fmt.Errorf("artifact contains additional JSON values")
+		}
+		return err
+	}
+	return nil
+}
+
+// ArchiveCurrentV1 identifies the retained committed source for the untouched
+// historical artifact before migrating it with its explicit store declaration.
+func ArchiveCurrentV1(ctx context.Context, dir, configuration, inventory string) (V1Archive, error) {
+	if err := validateConfigurationName(configuration); err != nil {
+		return V1Archive{}, err
+	}
+	root, err := EvidenceRoot(dir)
+	if err != nil {
+		return V1Archive{}, err
+	}
+	relative := filepath.ToSlash(filepath.Join("integration_tests/fixtures/longrun/gate", filepath.Base(freezePath(dir, configuration))))
+	revision, err := sourceGit(ctx, root, "log", "-1", "--format=%H", "--", relative)
+	if err != nil {
+		return V1Archive{}, err
+	}
+	retained := strings.TrimSpace(string(revision))
+	if !sourceHex(retained, 20) {
+		return V1Archive{}, fmt.Errorf("historical artifact lacks retained source commit")
+	}
+	original, err := sourceGit(ctx, root, "show", retained+":"+relative)
+	if err != nil {
+		return V1Archive{}, err
+	}
+	current, err := readFile(dir, filepath.Join("gate", filepath.Base(relative)))
+	if err != nil {
+		return V1Archive{}, err
+	}
+	if !bytes.Equal(original, current) {
+		return V1Archive{}, fmt.Errorf("historical artifact differs from retained committed source")
+	}
+	return ArchiveV1(dir, configuration, inventory, retained)
+}
diff --git b/integration_tests/fixtures/longrun/gate/source.go b/integration_tests/fixtures/longrun/gate/source.go
new file mode 100644
index 0000000..d0e6a59
--- /dev/null
+++ b/integration_tests/fixtures/longrun/gate/source.go
@@ -0,0 +1,231 @@
+package suite
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/CaliLuke/loom-mcp/v2/eval/gate"
+)
+
+// SourceFile binds one compiler-selected local source or dependency-owner file.
+type SourceFile struct {
+	Path   string `json:"path"`
+	SHA256 string `json:"sha256"`
+	Mode   uint32 `json:"mode"`
+}
+
+// SourceModule records the selected graph, including versioned replacements.
+// Local is a logical repository-relative module root, never a checkout path.
+type SourceModule struct {
+	Path     string        `json:"path"`
+	Version  string        `json:"version"`
+	Sum      string        `json:"sum"`
+	GoModSum string        `json:"go_mod_sum"`
+	Local    string        `json:"local,omitempty"`
+	Replace  *SourceModule `json:"replace,omitempty"`
+}
+
+// SourceIdentity is independent of checkout location, HEAD and artifact bytes.
+// Those belong to recovery provenance, not executable semantic equality.
+type SourceIdentity struct {
+	Version   int               `json:"version"`
+	Owners    []SourceFile      `json:"owners"`
+	Modules   []SourceModule    `json:"modules"`
+	Build     map[string]string `json:"build"`
+	Toolchain map[string]string `json:"toolchain"`
+	SHA256    string            `json:"sha256"`
+}
+
+// SourceSnapshot resolves the command and design dependency closure against the
+// selected workspace and hashes its source, embedded assets and module inputs.
+func SourceSnapshot(ctx context.Context, root string) (SourceIdentity, error) {
+	root, err := filepath.Abs(root)
+	if err != nil {
+		return SourceIdentity{}, err
+	}
+	root, err = filepath.EvalSymlinks(root)
+	if err != nil {
+		return SourceIdentity{}, err
+	}
+	dir := filepath.Join(root, "integration_tests/fixtures/longrun")
+	build, err := sourceEnvironment(ctx, dir, root)
+	if err != nil {
+		return SourceIdentity{}, err
+	}
+	identity := SourceIdentity{Version: 1, Build: build, Toolchain: make(map[string]string)}
+	if _, err := sourceGo(ctx, dir, "mod", "verify"); err != nil {
+		return identity, err
+	}
+	owners := make(map[string]bool)
+	owners["go.work"] = true
+	moduleData, err := sourceGo(ctx, dir, "list", "-mod=readonly", "-m", "-json", "all")
+	if err != nil {
+		return identity, err
+	}
+	var modules []listedSourceModule
+	if err := decodeSourceStream(moduleData, &modules); err != nil {
+		return identity, err
+	}
+	cacheData, err := sourceGo(ctx, dir, "env", "GOMODCACHE")
+	if err != nil {
+		return identity, err
+	}
+	cache := strings.TrimSpace(string(cacheData))
+	for _, module := range modules {
+		resolved, err := sourceModuleIdentity(root, cache, module)
+		if err != nil {
+			return identity, err
+		}
+		identity.Modules = append(identity.Modules, resolved)
+		if module.Main {
+			local, err := sourceRelative(root, module.Dir)
+			if err != nil {
+				return identity, err
+			}
+			owners[filepath.ToSlash(filepath.Join(local, "go.mod"))] = true
+			owners[filepath.ToSlash(filepath.Join(local, "go.sum"))] = true
+		}
+	}
+	packageData, err := sourceGo(ctx, dir, "list", "-mod=readonly", "-deps", "-json", "./cmd/compaction-gate", "./design")
+	if err != nil {
+		return identity, err
+	}
+	var packages []listedSourcePackage
+	if err := decodeSourceStream(packageData, &packages); err != nil {
+		return identity, err
+	}
+	goRootData, err := sourceGo(ctx, dir, "env", "GOROOT")
+	if err != nil {
+		return identity, err
+	}
+	goRoot := strings.TrimSpace(string(goRootData))
+	usedModules := make(map[string]bool)
+	for _, pkg := range packages {
+		if pkg.Error != nil {
+			return identity, fmt.Errorf("source package %s: %s", pkg.ImportPath, pkg.Error.Err)
+		}
+		if pkg.Standard {
+			for _, file := range pkg.files() {
+				path := filepath.Join(pkg.Dir, file)
+				relative, err := sourceRelative(goRoot, path)
+				if err != nil {
+					return identity, err
+				}
+				data, err := readFile(goRoot, relative)
+				if err != nil {
+					return identity, err
+				}
+				identity.Toolchain[relative] = gate.Digest(data)
+			}
+			continue
+		}
+		if pkg.Module == nil {
+			return identity, fmt.Errorf("source package %s has no module identity", pkg.ImportPath)
+		}
+		local := pkg.Module.Main || (pkg.Module.Replace != nil && pkg.Module.Replace.Version == "")
+		if !local {
+			resolved := pkg.Module
+			if resolved.Replace != nil {
+				resolved = resolved.Replace
+			}
+			usedModules[resolved.Path+"@"+resolved.Version] = true
+			continue
+		}
+		for _, file := range pkg.files() {
+			relative, err := sourceRelative(root, filepath.Join(pkg.Dir, file))
+			if err != nil {
+				return identity, err
+			}
+			owners[relative] = true
+		}
+	}
+	for i := range identity.Modules {
+		if err := selectedSourceSums(cache, &identity.Modules[i], usedModules); err != nil {
+			return identity, err
+		}
+	}
+	for path := range owners {
+		data, err := readFile(root, path)
+		if err != nil {
+			return identity, fmt.Errorf("source owner %s: %w", path, err)
+		}
+		info, err := os.Stat(filepath.Join(root, path))
+		if err != nil {
+			return identity, err
+		}
+		mode := uint32(0644)
+		if info.Mode().Perm()&0111 != 0 {
+			mode = 0755
+		}
+		identity.Owners = append(identity.Owners, SourceFile{Path: path, SHA256: gate.Digest(data), Mode: mode})
+	}
+	for _, tool := range []string{"bin/go", "pkg/tool/" + build["GOHOSTOS"] + "_" + build["GOHOSTARCH"] + "/compile", "pkg/tool/" + build["GOHOSTOS"] + "_" + build["GOHOSTARCH"] + "/link", "pkg/tool/" + build["GOHOSTOS"] + "_" + build["GOHOSTARCH"] + "/asm"} {
+		data, err := readFile(goRoot, tool)
+		if err != nil {
+			return identity, err
+		}
+		identity.Toolchain[tool] = gate.Digest(data)
+	}
+	// Assembly also consumes shared headers outside package-local file lists.
+	// Hash their actual bytes, not the GOROOT location or modification times.
+	headers, err := os.ReadDir(filepath.Join(goRoot, "pkg/include"))
+	if err != nil {
+		return identity, err
+	}
+	if len(headers) == 0 {
+		return identity, fmt.Errorf("source toolchain has no shared assembler headers")
+	}
+	for _, header := range headers {
+		if !header.Type().IsRegular() {
+			return identity, fmt.Errorf("unsupported shared assembler input %s", header.Name())
+		}
+		path := filepath.ToSlash(filepath.Join("pkg/include", header.Name()))
+		data, err := readFile(goRoot, path)
+		if err != nil {
+			return identity, err
+		}
+		identity.Toolchain[path] = gate.Digest(data)
+	}
+	sort.Slice(identity.Owners, func(i, j int) bool { return identity.Owners[i].Path < identity.Owners[j].Path })
+	sort.Slice(identity.Modules, func(i, j int) bool { return identity.Modules[i].Path < identity.Modules[j].Path })
+	data, err := json.Marshal(identity)
+	if err != nil {
+		return identity, err
+	}
+	identity.SHA256 = gate.Digest(data)
+	return identity, nil
+}
+
+func sourceRelative(root, path string) (string, error) {
+	resolved, err := filepath.EvalSymlinks(path)
+	if err != nil {
+		return "", err
+	}
+	relative, err := filepath.Rel(root, resolved)
+	if err != nil || relative == ".." || strings.HasPrefix(relative, ".."+string(filepath.Separator)) || filepath.IsAbs(relative) {
+		return "", fmt.Errorf("source input outside logical root: %s", path)
+	}
+	return filepath.ToSlash(relative), nil
+}
+
+func decodeSourceStream[T any](data []byte, out *[]T) error {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	for {
+		var value T
+		err := decoder.Decode(&value)
+		if err == io.EOF {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		*out = append(*out, value)
+	}
+}
diff --git b/integration_tests/fixtures/longrun/gate/source_bundle.go b/integration_tests/fixtures/longrun/gate/source_bundle.go
