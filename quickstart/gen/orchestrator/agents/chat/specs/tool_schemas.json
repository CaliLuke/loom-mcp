{
  "tools": [
    {
      "id": "helpers.answer",
      "service": "orchestrator",
      "toolset": "orchestrator.helpers",
      "title": "Answer",
      "description": "Answer a simple question",
      "payload": {
        "name": "AnswerPayload",
        "schema": {
          "additionalProperties": false,
          "examples": [
            {
              "question": "What is the capital of Japan?"
            }
          ],
          "properties": {
            "question": {
              "description": "User question to answer",
              "examples": [
                "What is the capital of Japan?"
              ],
              "type": "string"
            }
          },
          "required": [
            "question"
          ],
          "type": "object"
        }
      },
      "result": {
        "name": "AnswerResult",
        "schema": {
          "additionalProperties": false,
          "properties": {
            "text": {
              "description": "Answer text",
              "examples": [
                "Tokyo is the capital of Japan."
              ],
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        }
      }
    }
  ]
}
